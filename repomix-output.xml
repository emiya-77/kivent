export function UnsplashImagePicker({ isOpen, onClose, onSelect }) {
    const [query, setQuery] = useState("");
    const [images, setImages] = useState([]);
    const [loading, setLoading] = useState(false);

    const searchImages = async (searchQuery) => {
        setLoading(true);
